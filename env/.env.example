# ---------- IBEx ----------
# Base URL of the IBEx API (testnet)
IBEX_API_URL=https://passkeys-testnet.ibex.fi

# ─── WebAuthn Relying Party ID (rpId) ───────────────────────────────────────
#
# CRITICAL: IBEX_RP_ID MUST match the hostname visible in the browser address bar.
# WebAuthn enforces this at the browser level — there is no workaround.
#
# The server signs the JWT with issuer = rpId, and verifies incoming requests
# by matching the JWT issuer against the rpId sent in headers. If they don't
# match → 401 Unauthorized.
#
# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ Scenario A — Dev on localhost                                              │
# │                                                                            │
# │   Browser URL:  http://localhost:5173/app/profile                          │
# │   IBEX_RP_ID=localhost                                                     │
# │                                                                            │
# │   → WebAuthn rpId = localhost  ✅ (matches browser hostname)               │
# │   → JWT issuer   = localhost  ✅ (matches rpId in API headers)             │
# │   → Sign-in / GET /users/me   ✅                                          │
# │   → POST /users/me            ✅ (localhost is registered on TESTNET)      │
# │                                                                            │
# │   Good for: quick auth testing, full dev iteration on testnet.             │
# ├──────────────────────────────────────────────────────────────────────────────┤
# │ Scenario B — Dev with custom hostname (full functionality)                 │
# │                                                                            │
# │   1. Add to /etc/hosts:  127.0.0.1  demobaas-prat1.ibex.fi                │
# │   2. Open browser at:    http://demobaas-prat1.ibex.fi:5173/app/profile   │
# │   3. Set:                IBEX_RP_ID=demobaas-prat1.ibex.fi                │
# │                                                                            │
# │   → WebAuthn rpId = demobaas-prat1.ibex.fi  ✅ (matches browser hostname) │
# │   → JWT issuer   = demobaas-prat1.ibex.fi   ✅ (matches rpId in headers)  │
# │   → All endpoints work including POST /users/me  ✅                        │
# │                                                                            │
# │   Good for: full integration testing with write operations.                │
# ├──────────────────────────────────────────────────────────────────────────────┤
# │ ⛔ DOES NOT WORK — rpId mismatch                                          │
# │                                                                            │
# │   Browser URL:  http://localhost:5173/...                                  │
# │   IBEX_RP_ID=demobaas-prat1.ibex.fi  ← WRONG                             │
# │                                                                            │
# │   WebAuthn will either:                                                    │
# │   - Refuse to create/get credentials (rpId is not a suffix of localhost)   │
# │   - If forced via header tricks, the server will reject the credential     │
# │     because authenticatorData.rpIdHash won't match the expected rpId.      │
# │                                                                            │
# │   There is NO workaround. This is a WebAuthn security constraint.          │
# └──────────────────────────────────────────────────────────────────────────────┘
#
# Users and credentials are namespaced by rpId. A user created under
# rpId=localhost is invisible under rpId=demobaas-prat1.ibex.fi and vice versa.
#
# The rpId must be registered in IBEXSAFE for write operations (POST /users/me).
# On TESTNET (passkeys-testnet.ibex.fi), both "localhost" and
# "demobaas-prat1.ibex.fi" are pre-registered.
#
IBEX_RP_ID=localhost

# Local dev server port
PORT=5173
